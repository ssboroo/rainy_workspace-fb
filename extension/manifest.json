{
  "manifest_version": 3,
  "name": "RAINY FB Pro",
  "version": "5.6.7",
  "minimum_chrome_version": "120",
  "description": "Групп нийтлэлт, баталгаажсан явц, Smart Scheduler, Lead Finder, Wire.mn төлбөр ба серверийн лиценз.",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "sidePanel",
    "unlimitedStorage",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://rainy-fb-license-production.up.railway.app/*"
  ],
  "optional_host_permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; connect-src 'self' data: blob: https://rainy-fb-license-production.up.railway.app https://*.facebook.com; img-src 'self' data: blob: https:;"
  },
  "action": {
    "default_title": "RAINY Pro",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html?mode=side"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "content-facebook.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
