# Same variable names as ssboroo/socialtool-store. Copy values into SERVER settings only.
WIRE_MN_API_URL=https://api.wire.mn/v1
WIRE_MN_API_KEY=
WIRE_MN_WEBHOOK_SECRET=
WIRE_MN_ALLOWED_OPERATORS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Telegram user's numeric ID (not bot ID; in private chat often same as chat ID).
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_URL=https://YOUR-SERVER-DOMAIN
REGISTER_TELEGRAM_WEBHOOK=false
ALLOW_MANUAL_PAYMENT=false
DB_PATH=/data/rainy.sqlite3
PORT=8080
