{
  "manifest_version": 3,
  "name": "RAINY FB Pro Mobile",
  "version": "0.3.2",
  "description": "RAINY FB Pro Safari companion extension.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://workspace.rainy.studio/mobile/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://m.facebook.com/*"],
      "js": ["browser-compat.js", "content-facebook.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://workspace.rainy.studio/mobile/*"],
      "js": ["workspace.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "15.4"
    }
  }
}
